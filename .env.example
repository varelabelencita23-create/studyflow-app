# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings → API in the Supabase dashboard). Never commit `.env`.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time by
# Expo — safe for the anon key (it's designed to be public) as long as Row
# Level Security is enabled on every table, which the migrations in
# supabase/migrations/ do. Never put the `service_role` key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
